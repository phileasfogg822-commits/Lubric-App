{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lubric.app",
  "version": "0.1.2",
  "identifier": "app.lubric.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lubric.app",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwRUU2RjRENjk4NzQyNTcKUldSWFFvZHBUVy91MEJqeTU4eFpmYXRCUlNST2hIQ3hubEVBelJieEt5QXIzc3FYcEY5Z29UR2YK",
      "endpoints": [
        "https://github.com/phileasfogg822-commits/Lubric-App/releases/download/windows-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
