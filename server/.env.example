# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lubricapp
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret - CHANGE THIS in production!
JWT_SECRET=lubric-app-dev-secret-change-in-production

# ── Production (VPS) ─────────────────────────────────────────────
# docker-compose.prod.yml reads DB_NAME, DB_USER, DB_PASSWORD and JWT_SECRET
# from the .env file next to it, and refuses to start without them.
# Generate secrets with: openssl rand -hex 32
# See DEPLOY.md for the full walkthrough.

